{
  "name": "downtown-mars",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "bridge": "node scripts/bridge.mjs",
    "playtest": "PLAYTEST=1 vitest run tests/playthrough.test.ts --reporter=default --silent=false",
    "package": "npm run build && node scripts/package.mjs",
    "playtest:net": "PLAYTEST=1 vitest run tests/network-playthrough.test.ts --reporter=default --silent=false"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
