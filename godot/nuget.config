<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Godot ships its C# SDK inside the app: use that, so building needs no download of it. -->
  <packageSources>
    <add key="GodotSharp" value="/Applications/Godot_mono.app/Contents/Resources/GodotSharp/Tools/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
